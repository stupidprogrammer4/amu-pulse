fastapi:
  title: "AMU Pulse"
  description: >-
    Aggregates Iranian and global gold and FX market data, calculates asset
    prices, and serves live tickers and candlestick charts.
  version: "0.1.0"

taskiq:
  redis_url: "redis://0.0.0.0:6379/0"
  max_connection_pool_size: 25

postgresql:
  test_dsn: >-
    postgresql+asyncpg://postgres:secure_pwd@0.0.0.0:5432/pulse_test_db
  dsn: "postgresql+asyncpg://postgres:secure_pwd@0.0.0.0:5432/core_pulse_db"
  pool_timeout: 30
  pool_recycle: 1800
  pool_size: 20
  max_overflow: 5

crypto:
  encryption_key: "MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA="
  password_salt: "local-development-password-salt"

redis:
  url: "redis://0.0.0.0:6379/0"
  max_connections: 10
  socket_timeout: 5.0
  socket_connect_timeout: 5.0
  health_check_interval: 30

jwt:
  algorithm: "HS256"
  secret_key: "local-development-jwt-secret"
  access_token_expire_minutes: 60
  refresh_token_expire_minutes: 20160
  api_secret: "local-development-api-secret"

csrf:
  secret_key: "local-development-csrf-secret"

storage:
  path: "media"
  temp_dir: "tmp"
  max_file_size: 5242880
  allowed_extensions: ["jpg", "jpeg", "png", "webp"]

es:
  hosts:
    - "http://0.0.0.0:9200"
  username: null
  password: null
  api_key: null
  verify_certs: false
  ca_certs: null

rabbitmq:
  url: "amqp://guest:guest@0.0.0.0:5672//"

logging:
  level: "INFO"
  format: "console"
  service: "amu-pulse-api"
