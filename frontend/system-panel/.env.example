# Base URL every API call is prefixed with.
# In dev keep it as /api so Vite's proxy forwards to VITE_PROXY_TARGET.
VITE_API_BASE_URL=/api

# Where the dev proxy forwards /api requests (the FastAPI backend).
VITE_PROXY_TARGET=http://127.0.0.1:8000

VITE_APP_TITLE=AMU Pulse System Panel

# Label shown in the sidebar so nobody mistakes prod for a sandbox.
VITE_ENVIRONMENT=development

# Request timeout in milliseconds.
VITE_REQUEST_TIMEOUT=20000
